# OpenAI key used server-side only to mint short-lived Realtime client secrets
OPENAI_API_KEY=
# Data Foundation MCP, exposed by the AIDA MCP gateway (copy the connector URL from the MCP card in AIDA)
DATA_FOUNDATION_MCP_URL=https://aida.atida.com/api/mcp/g/data-foundation-mcp/mcp
# Static gateway API key created in AIDA under /settings/mcp-tokens (scoped to Data Foundation)
DATA_FOUNDATION_MCP_TOKEN=
# Optional
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
